    {
      "id": "dlg_zhao_deacon",
      "npc": "npc_huangfeng_outer",
      "scenes": [
        {
          "when": "first_meet",
          "lines": [
            "报上名来。",
            "木灵根？先领长春功残页，别想一步登天。",
            "筑基丹？贡献够了再问。"
          ]
        },
        {
          "when": "high_rep",
          "lines": [
            "你还算给谷里争脸。",
            "地火室？我替你递个话。"
          ]
        },
        {
          "when": "low_rep",
          "lines": [
            "滚出山门。",
            "再靠近巡卫的剑不长眼。"
          ]
        }
      ],
      "description": "【对话包】NPC npc_huangfeng_outer。场景数 3。first_meet：报上名来。／木灵根？先领长春功残页，别想一步登天。／筑基丹？贡献够了再问。 high_rep：你还算给谷里争脸。／地火室？我替你递个话。 low_rep：滚出山门。／再靠近巡卫的剑不长眼。",
      "display": "对话·npc_huangfeng_outer",
      "type": "npc_dialogue",
      "tags": [
        "dialogue_v117"
      ]
    },
    {
      "id": "dlg_dan_tang",
      "npc": "npc_huangfeng_dan_tang",
      "scenes": [
        {
          "when": "apprentice",
          "lines": [
            "火候数着，别跟我扯天赋。",
            "炸炉赔灵石，没有例外。"
          ]
        },
        {
          "when": "ask_foundation",
          "lines": [
            "你听不见我说「不谈」吗？",
            "有令再来。"
          ]
        }
      ],
      "description": "【对话包】NPC npc_huangfeng_dan_tang。场景数 2。apprentice：火候数着，别跟我扯天赋。／炸炉赔灵石，没有例外。 ask_foundation：你听不见我说「不谈」吗？／有令再来。",
