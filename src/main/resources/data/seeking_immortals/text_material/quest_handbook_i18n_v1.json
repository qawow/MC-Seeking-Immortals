  "line_summaries_en": {
    "mortal_qixuan_entry": "Spiritual roots come before immortal cultivation. The Changchun Art is only the first step toward survival.",
    "huangfeng_blood_quota": "This entrance token is earned through contribution, not personal favors.",
    "blood_forbidden_run": "Gather medicine, judge rivals, and escape before the secret-realm window closes.",
    "nangong_wan_weight_optional": "A jiao waits underwater and another disciple waits ashore; hunt, help, or leave.",
    "star_palace_register": "Star Palace sets the rules of the Chaotic Sea: register before seeking legal passage.",
    "inverse_star_intro": "Give the correct countersign before speaking, and keep Star Palace agents away.",
    "tianyuan_landing_register": "Old mortal-realm status means little here; register first and adapt to Spirit Realm qi.",
    "tianyuan_to_fengyuan_gate": "The controlled gate opens for merit, and not one point less.",
    "zhenyan_outer_lesson": "Words carry law here; outer disciples may listen before they are allowed to ask.",
    "wuxing_intro": "The Illusory World seed is not a toy, and contemplation requires earned standing.",
    "reincarnation_intro": "Read the backlash terms before signing a contract for forbidden goods.",
    "court_hunt_gray": "Choose whether to kill or capture the Gray Realm agents named on the warrant.",
    "heifeng_gray_sail": "Follow the flag, wind, and helmsman; favored agents of the Court are refused passage.",
    "xutian_window_prepare": "A completed map only grants entry; there is still only one supreme cauldron.",
    "kunwu_clue_assemble": "Kunwu does not wait open: without every clue, its gate remains sealed.",
    "zhuimo_token": "A token grants entry, but entering without fire resistance buys only a grave.",
    "lingzhu_fruit_run": "There is one fruit tree, and its once-per-life fortune is not an infinite trade good.",
    "yinyang_ku_intel": "In a cavern steeped in yin poison, buy survival before buying directions.",
    "peiying_material_hunt": "The alchemical ingredient must be captured alive; a corpse is worth far less.",
    "qianzhu_tower_trial": "Stop the mechanisms, break the control cores, and seize the tower instead of relying on force.",
    "dayan_clue": "Assemble the inheritance page by page; the complete art is neither sold nor guaranteed.",
    "guanghan_endgame_path": "The Spirit Refinement Art is unique, and a True Immortal's pressure is not a farmable boss encounter.",
    "deity_huoyu_path": "Balance cold flame, gather limited essence fire, and prepare a unique return-to-yang route before ascension.",
    "mulan_tiannan_war_campaign": "War merit and talisman fire rule the sandstorm while closed borders override ordinary travel.",
    "mulan_scout_clash": "A grassland scouting branch within the Mulan campaign.",
    "fashi_soul_array_battle": "A spell-warrior formation branch within the Mulan campaign.",
    "holy_bird_blessing_quest": "A sacred-bird blessing branch within the Mulan campaign.",
    "xianjie_ascension_path": "Tribulation is only the admission token; arrival begins an entirely new path.",
    "zhenyan_men_path": "The True Word Sect is a ladder of qualifications from lectures to the Illusory World.",
    "time_law_path": "The law of time is not idle acceleration, and reversal carries heavenly consequences.",
    "reincarnation_hall_path": "A long route from introductions to deeper contracts, forbidden goods, and debts.",
    "heifeng_and_gray": "Black Wind is the road and the Gray Realm is the fog, with no sign pointing back.",
    "xianjie_endgame_glimpse": "The endgame offers distant hooks, not a guaranteed path to final victory.",
    "xutian_palace_run": "Preparation is over; unique treasures belong only to those who leave the palace alive.",
    "kunwu_expedition_run": "With every clue assembled, enter the mountain where sealed fire and demons wait."
  },
