{
  "schema_version": 2,
  "note": "v138 扩写 archetypes 对话；详见 npc_dialogue_templates_v138.json",
  "archetypes": [
    {
      "id": "sect_contribution_clerk",
      "display": "宗门贡献执事",
      "lines": {
        "greeting": [
          "禁地的令，是贡献堆出来的，不是求来的。",
          "任务牌在那边。做完再来核销。"
        ],
        "quest_offer": [
          "药园缺人、后山妖兽闹腾——拣你能做的。",
          "配额将开，贡献不够就别惦记试炼令。"
        ],
        "quest_turnin": [
          "东西齐了。贡献已记上，别挥霍。",
          "做得干净。下回难一些。"
        ],
        "rep_gate": [
          "外门权限只到此为止。",
          "内门凭证呢？没有就去任务牌挣。"
        ],
        "farewell": [
          "去罢，别在殿里吵闹。"
        ]
      },
      "binds": [
        "npc_huangfeng_contribution",
        "contribution_stele",
        "inner_sect_task_board"
      ],
      "branch_tree_id": "tree_sect_contribution_clerk",
      "v142_line_polish": true
    },
    {
      "id": "teleport_array_keeper",
      "display": "传送阵看守",
      "lines": {
        "greeting": [
          "要传哪里？灵石与令牌都备好了？",
          "阵纹刚保养过，别在启动时乱动。"
        ],
        "travel": [
          "目标阵有回应，站中间，收神。",
          "远程加价，不二价。"
        ],
        "rep_gate": [
          "你这令牌过期了。",
          "敌对势力，阵不启。"
        ],
        "threat": [
          "再近一步，杀阵先请。"
        ],
        "farewell": [
          "落地别挡道。"
        ]
      },
      "binds": [
        "teleport_array_pedestal",
        "star_palace_teleport_gate",
        "node_*"
      ],
      "branch_tree_id": "tree_teleport_array_keeper"
    },
    {
      "id": "star_palace_registrar",
      "display": "星宫注册吏",
      "lines": {
        "greeting": [
          "乱星海的规矩，星宫说了算。先登记。",
          "无籍散修，传送加价，无议价。"
        ],
        "shop": [
          "注册费、月例、岛际传送折扣，表上写得明白。"
        ],
        "rep_gate": [
          "逆星的气味洗不掉，驳回。",
          "贡献与月例未清，航线不开。"
        ],
        "lore": [
          "岛与岛之间，没有星灯与阵，十有八九葬海。"
        ],
        "farewell": [
          "下一艘船不等人。"
        ]
      },
      "binds": [
        "npc_star_palace_clerk",
        "node_star_palace"
      ],
      "branch_tree_id": "tree_star_palace_registrar",
      "v142_line_polish": true
    },
    {
      "id": "inverse_star_contact",
      "display": "逆星接头人",
      "lines": {
        "greeting": [
          "暗号对了？不对就滚。",
          "星宫眼线多，有话快说。"
        ],
        "shop": [
          "货在暗港，价用灵石和人情一起算。"
        ],
        "travel": [
          "趸船阵今晚有空位，别带尾巴。"
        ],
        "threat": [
          "出卖我们的，海葬。"
        ],
        "farewell": [
          "散了，别同路。"
        ]
      },
      "binds": [
        "inverse_star_smuggle_dock",
        "node_inverse_star_hideout"
      ],
      "branch_tree_id": "tree_inverse_star_contact"
    },
    {
      "id": "tianyuan_registrar",
      "display": "天渊登记官",
      "lines": {
        "greeting": [
          "飞升者？人界的名头到了灵界，只是个记号。",
          "先登记。灵气不适应就别急着出城送死。"
        ],
        "quest_offer": [
          "驻军差事可换贡献，界门费也能减。"
        ],
        "travel": [
          "风元界门，五百贡献。少一文，门不开。",
          "想回人界？分身去。本体留下。"
        ],
        "lore": [
          "天渊是踏板，不是终点。"
        ],
        "farewell": [
          "适应灵气再出门，别走火。"
        ]
      },
      "binds": [
        "npc_tianyuan_registrar",
        "gate_tianyuan_to_fengyuan"
      ],
      "branch_tree_id": "tree_tianyuan_registrar",
      "v142_line_polish": true
    },
    {
      "id": "zhenyan_lecturer",
      "display": "真言门授业长老",
      "lines": {
        "greeting": [
          "真言一道，口舌即法。",
          "外门弟子，先听完再问。"
        ],
        "quest_offer": [
          "此课听完，去演练大五行入门。",
          "幻世种子不是玩具，等你资格够了再说。"
        ],
        "lore": [
          "时间与五行，皆是道。急不得。"
        ],
        "rep_gate": [
          "门中法旨未授，不可妄传。"
        ],
        "farewell": [
          "退。"
        ]
      },
      "binds": [
        "npc_zhenyan_elder_template",
        "true_word_lecture_platform"
      ],
      "branch_tree_id": "tree_zhenyan_lecturer"
    },
    {
      "id": "reincarnation_clerk",
      "display": "轮回殿接引",
      "lines": {
        "greeting": [
          "契约在此，签字前请读完反噬条。",
          "轮回殿不做亏本买卖。"
        ],
        "shop": [
          "魂类物、情报、禁忌路引，明码或暗码。"
        ],
        "threat": [
          "悔约者，魂契自收。"
        ],
        "lore": [
          "有些路，比死亡更贵。"
        ],
        "farewell": [
          "殿外勿提今日所谈。"
        ]
      },
      "binds": [
        "npc_reincarnation_clerk",
        "reincarnation_trade_desk"
      ],
      "branch_tree_id": "tree_reincarnation_clerk"
    },
    {
      "id": "heavenly_inspector",
      "display": "天庭巡察",
      "lines": {
        "greeting": [
          "报上名号与驻地。",
          "灰界走卒与黑风私枭，格杀勿论。"
        ],
        "rep_gate": [
          "你名在通缉册。"
        ],
        "threat": [
          "律法当前，收手或受缚。"
        ],
        "lore": [
          "仙界亦有天条，非人界散修可比。"
        ],
        "farewell": [
          "退到一旁，勿阻公务。"
        ]
      },
      "binds": [
        "npc_heavenly_court_inspector"
      ],
      "branch_tree_id": "tree_heavenly_inspector"
    },
    {
      "id": "heifeng_captain",
      "display": "黑风舵主",
      "lines": {
        "greeting": [
          "船上规矩：听旗、听风、听我。",
          "想过灰界？先问你命硬不硬。"
        ],
        "travel": [
          "涨潮开船，灵石与人手都要齐。"
        ],
        "shop": [
          "海货换仙石，价随风浪。"
        ],
        "farewell": [
          "抓牢舷，别喂海。"
        ]
      },
      "binds": [
        "npc_heifeng_captain",
        "node_immortal_heifeng"
      ],
      "branch_tree_id": "tree_heifeng_captain"
    },
    {
      "id": "gray_guide",
      "display": "灰界引路人",
      "lines": {
        "greeting": [
          "……跟紧。别问名字。",
          "天庭的人？那我们无话可说。"
        ],
        "travel": [
          "边境雾起时走，晚了就不是原价。"
        ],
        "threat": [
          "丢下你，雾会替我收尾。"
        ],
        "farewell": [
          "到此为止，其余自求。"
        ]
      },
      "binds": [
        "npc_gray_border_guide"
      ],
      "branch_tree_id": "tree_gray_guide"
    },
    {
      "id": "market_vendor",
      "display": "坊市摊主",
      "lines": {
        "greeting": [
          "看看货？不买也别动手。",
          "今日灵药新到，价公道。"
        ],
        "shop": [
          "灵石当面点清，概不赊账。"
        ],
        "farewell": [
          "慢走，记着回头客有薄利。"
        ]
      },
      "binds": [
        "market_stall_counter"
      ],
      "branch_tree_id": "tree_market_vendor"
    },
    {
      "id": "secret_realm_guide",
      "display": "秘境领队/执事",
      "lines": {
        "greeting": [
          "令牌？配额？窗口要关了。",
          "进去保住小命比抢宝重要——说给新人听的。"
        ],
        "travel": [
          "触界碑，收神，别掉队。"
        ],
        "threat": [
          "超时不撤，禁地自己会清场。"
        ],
        "farewell": [
          "活着出来再吹牛。"
        ]
      },
      "binds": [
        "blood_forbidden_entry_stele",
        "node_blood_forbidden_entry"
      ],
      "branch_tree_id": "tree_secret_realm_guide"
    }
  ],
